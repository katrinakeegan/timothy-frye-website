@article{frye2025aid,
  title = {What Moves Public Support for Aid to Ukraine? Issue Attention, Partisanship, and Normative Appeals},
  author = {Frye, Timothy},
  journal = {Political Science Quarterly},
  year = {2025},
  volume = {140},
  number = {2},
  pages = {229--247},
  doi = {10.1093/psquar/qqae085},
  topics = {public-opinion, ukraine-war},
  abstract = {Since 2022, the United States has provided more aid to Ukraine than to any other country, but this policy has become increasingly contentious. Identifying the nature of public support for this aid is critical for public policy, but it also raises central issues for scholars studying foreign policy preferences. I conducted a preregistered survey experiment that varies partisan cues and the content of appeals to support aid to Ukraine. I find that these appeals are strongly conditioned by partisanship and attention to the issue. Among Democrats, normative appeals increase support. Among Republicans, and to a lesser extent, independents, a partisan appeal by Donald Trump reduces support. However, these findings only hold among respondents not following the issue closely. On this high-profile issue in a polarized setting, other appeals largely fail to move attitudes. These results point to a paradox. Those respondents most likely to be moved by appeals for or against aid to Ukraine are also those paying the least attention to the issue, which suggests it will be difficult to move public attitudes on support for aid to Ukraine.}
}

@article{frye2024norms,
  title = {Do Violations of Democratic Norms Change Political Attitudes? Evidence from the January 6th Insurrection},
  author = {Frye, Timothy},
  journal = {American Politics Research},
  year = {2024},
  volume = {52},
  number = {2},
  pages = {118--127},
  doi = {10.1177/1532673x231221987},
  topics = {public-opinion},
  abstract = {How do citizens respond to extreme violations of democratic institutions, such as the January 6th, 2021 insurrection at the US Capitol? Using an online survey of 900 employed respondents conducted January 5–9, 2021, I find that those interviewed just hours after the insurrection were about 10\% points less likely to identify as Republicans, reported greater dislike for Donald Trump, and expressed less attachment to conservatism even controlling for prior levels of party identification. Self-reported Trump voters interviewed after the insurrection were also less likely to identify as Republican and expressed a less favorable view of Donald Trump. The findings only reflect the short-term reactions of employed respondents but are robust to alternative specifications and the very narrow temporal window of the analyses helps to isolate the impact of the insurrection. These results offer evidence in the on-going debate over how to interpret the events of January 6th, 2021.}
}

